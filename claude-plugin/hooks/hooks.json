{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "punk",
            "args": [
              "hook",
              "session-start"
            ],
            "timeout": 30,
            "statusMessage": "punk: restoring memories"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "punk",
            "args": [
              "hook",
              "session-end"
            ],
            "timeout": 30,
            "statusMessage": "punk: saving memories"
          }
        ]
      }
    ]
  }
}
